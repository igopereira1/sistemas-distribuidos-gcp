# Servidor
PORT=3000

# Conexão com o Banco de Dados (MySQL / Google Cloud SQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app_db
DB_USER=admin
DB_PASSWORD=senha_do_banco

# Google Cloud Platform (GCP)
GCP_PROJECT_ID=id-do-projeto-gcp
GCS_BUCKET_NAME=bucket-imagens-gcp

# Autenticação local no GCP (opcional caso seja utilizada chave JSON localmente):
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account-key.json
